{
  "kind": "template",
  "id": "observability-watch",
  "version": 3,
  "name": {
    "en": "Observability watch",
    "pt-BR": "Vigia de observabilidade"
  },
  "description": {
    "en": "Reads the active incidents from Grafana Incident (IRM) and delivers to the inbox the ones that need you now. Needs Grafana Incident enabled in the Grafana you connect.",
    "pt-BR": "Lê os incidentes ativos do Grafana Incident (IRM) e entrega na inbox os que precisam de você agora. Precisa do Grafana Incident ligado no Grafana que você conectar."
  },
  "tags": [
    "digest",
    "grafana",
    "observability"
  ],
  "package": {
    "formato": "locum-pacote",
    "versao": 2,
    "automacao": {
      "id": "observability-watch",
      "spec": {
        "name": "Observabilidade do time",
        "defaultTools": [],
        "skills": [],
        "budget": {
          "perRunUsd": 0.1,
          "perDayUsd": 2
        },
        "steps": [
          {
            "type": "model",
            "key": "classify",
            "name": "Classificar Incidentes",
            "needs": [],
            "optional": false,
            "model": "claude-code/claude-sonnet-5",
            "maxSteps": 12,
            "requiresServers": [
              "grafana"
            ],
            "prompt": "Você é o guardião de observabilidade de uma pessoa que lidera um time de engenharia.\nBusque no Grafana os incidentes ativos, com as ferramentas de leitura dele, e diga o que realmente precisa dela agora. Abra o incidente quando a lista não disser o bastante para classificar. Você só lê: nada é criado nem alterado.\n\nPara cada incidente relevante:\n- `id`: identificador do incidente exatamente como veio.\n- `title`: título do incidente.\n- `severity`:\n  • `critical` se produção está degradada, incidente em andamento com impacto real, ou alarme de p95/erros disparado.\n  • `warning` se é anomalia que merece acompanhamento (latência subindo, erros pontuais, incidente recém-aberto sem causa clara).\n  • `info` se é rotina, incidente já resolvido que entrou na lista, ou baixo impacto.\n- `summary`: resumo executivo em UMA frase: o que está acontecendo, qual serviço, e qual o próximo passo sugerido (investigar, aguardar, escalar).\n\nSe não houver incidente ativo, devolva headline \"Sem incidentes ativos\" e lista vazia — sem inventar nada.",
            "outputSchema": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "headline",
                "incidents"
              ],
              "properties": {
                "headline": {
                  "type": "string"
                },
                "incidents": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "id",
                      "title",
                      "severity",
                      "summary"
                    ],
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "title": {
                        "type": "string"
                      },
                      "severity": {
                        "enum": [
                          "critical",
                          "warning",
                          "info"
                        ]
                      },
                      "summary": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            },
            "tools": [
              {
                "server": "grafana",
                "tool": "list_incidents",
                "class": "read"
              },
              {
                "server": "grafana",
                "tool": "get_incident",
                "class": "read"
              }
            ]
          },
          {
            "type": "action",
            "key": "deliver",
            "name": "Entregar na Fila",
            "needs": [
              "classify"
            ],
            "optional": false,
            "action": "digest.deliver",
            "mode": "approve",
            "input": "classify"
          }
        ]
      },
      "gatilhos": [
        {
          "kind": "schedule",
          "everyMinutes": 15,
          "workingHours": {
            "enabled": true,
            "start": "09:00",
            "end": "18:00",
            "days": [
              1,
              2,
              3,
              4,
              5
            ],
            "offHoursBehavior": "pause"
          }
        }
      ]
    },
    "agents": [],
    "requisitos": {
      "conexoes": [
        {
          "id": "grafana",
          "nome": "Grafana"
        }
      ],
      "servidores": [
        {
          "nome": "grafana",
          "conexao": "grafana"
        }
      ],
      "provedores": [
        {
          "provedor": "claude-code",
          "modelos": [
            "claude-sonnet-5"
          ]
        }
      ],
      "skills": []
    },
    "skills": [],
    "omitidos": []
  }
}
