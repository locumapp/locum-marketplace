{
  "kind": "template",
  "id": "teams-reply",
  "version": 1,
  "name": {
    "en": "Teams reply",
    "pt-BR": "Resposta no Teams"
  },
  "description": {
    "en": "Writes the reply to a Teams message and stops in the queue before sending.",
    "pt-BR": "Escreve a resposta à mensagem do Teams e para na fila antes de mandar."
  },
  "tags": [
    "teams"
  ],
  "package": {
    "formato": "locum-pacote",
    "versao": 2,
    "automacao": {
      "id": "teams-reply",
      "spec": {
        "name": "Resposta no Teams",
        "defaultTools": [],
        "skills": [],
        "budget": {
          "perRunUsd": 0.1,
          "perDayUsd": 1
        },
        "steps": [
          {
            "type": "model",
            "key": "write",
            "name": "Escrever a resposta",
            "needs": [],
            "optional": false,
            "model": "claude-code/claude-sonnet-5",
            "maxSteps": 4,
            "requiresServers": [],
            "prompt": "Escreva a resposta para esta mensagem do Teams.\n\nEm `text`, a resposta como ela sairia na conversa: direta, sem saudação\nde e-mail e sem repetir a pergunta. Se faltar informação para\nresponder, escreva o que falta em vez de supor.\n\nDe: {{event.author}}\n\nMensagem:\n{{event.text}}",
            "outputSchema": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "text"
              ],
              "properties": {
                "text": {
                  "type": "string"
                }
              }
            }
          },
          {
            "type": "action",
            "key": "post",
            "name": "Responder na conversa",
            "needs": [
              "write"
            ],
            "optional": false,
            "action": "teams.post",
            "mode": "approve",
            "input": "write"
          }
        ]
      },
      "gatilhos": []
    },
    "agents": [],
    "requisitos": {
      "conexoes": [
        {
          "id": "teams",
          "nome": "Microsoft Teams"
        }
      ],
      "servidores": [],
      "provedores": [
        {
          "provedor": "claude-code",
          "modelos": [
            "claude-sonnet-5"
          ]
        }
      ],
      "skills": []
    },
    "skills": [],
    "omitidos": []
  }
}
