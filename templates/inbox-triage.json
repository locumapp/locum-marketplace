{
  "kind": "template",
  "id": "inbox-triage",
  "version": 1,
  "name": {
    "en": "Inbox triage",
    "pt-BR": "Triagem da caixa de entrada"
  },
  "description": {
    "en": "Reads the Slack or Teams conversations and mentions you received and delivers to the inbox only what needs your attention.",
    "pt-BR": "Lê as conversas e menções que chegaram no Slack ou no Teams e entrega na inbox só o que pede a sua atenção."
  },
  "tags": [
    "digest",
    "slack",
    "teams"
  ],
  "package": {
    "formato": "locum-pacote",
    "versao": 2,
    "automacao": {
      "id": "inbox-triage",
      "spec": {
        "name": "Triagem da Caixa de Entrada",
        "defaultTools": [],
        "skills": [],
        "budget": {
          "perRunUsd": 0.05,
          "perDayUsd": 1
        },
        "steps": [
          {
            "type": "model",
            "key": "classify",
            "name": "Classificar Mensagens",
            "needs": [],
            "optional": false,
            "model": "claude-code/claude-sonnet-5",
            "maxSteps": 4,
            "requiresServers": [],
            "prompt": "Você é o assistente executivo e de engenharia de uma pessoa que lidera um time de engenharia.\nAnalise as conversas e menções recebidas (Slack ou Teams) e identifique apenas o que realmente exige a atenção dela.\n\nPara cada assunto relevante:\n- `channel`: nome ou id do canal/chat.\n- `subject`: remetente e assunto conciso (ex: \"@maria sobre o endpoint da API\").\n- `kind`: \n  • `needs_reply` se alguém fez uma pergunta direta ou solicitou uma decisão técnica/alinhamento pendente dela.\n  • `info` se for comunicado ou atualização que ela deve saber mas sem ação imediata.\n  • `ignore` se for ruído, bate-papo sem contexto de trabalho ou mensagem do próprio usuário.\n- `summary`: resumo executivo em UMA frase explicando o que foi pedido ou comunicado.\n- `threadTs`: carimbo da thread se houver.\n\nConversa recebida:\n{{event.channels}}",
            "outputSchema": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "headline",
                "items"
              ],
              "properties": {
                "headline": {
                  "type": "string"
                },
                "items": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "channel",
                      "subject",
                      "kind",
                      "summary"
                    ],
                    "properties": {
                      "channel": {
                        "type": "string"
                      },
                      "subject": {
                        "type": "string"
                      },
                      "kind": {
                        "enum": [
                          "needs_reply",
                          "info",
                          "ignore"
                        ]
                      },
                      "summary": {
                        "type": "string"
                      },
                      "threadTs": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          },
          {
            "type": "action",
            "key": "deliver",
            "name": "Apresentar na Fila",
            "needs": [
              "classify"
            ],
            "optional": false,
            "action": "digest.deliver",
            "mode": "approve",
            "input": "classify"
          }
        ]
      },
      "gatilhos": []
    },
    "agents": [],
    "requisitos": {
      "conexoes": [],
      "servidores": [],
      "provedores": [
        {
          "provedor": "claude-code",
          "modelos": [
            "claude-sonnet-5"
          ]
        }
      ],
      "skills": []
    },
    "skills": [],
    "omitidos": []
  }
}
