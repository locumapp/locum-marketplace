{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/locumapp/locum-marketplace/main/schemas/template.schema.json",
  "title": "Locum marketplace template",
  "description": "An automation template: a Locum package (the format import_package reads) with the automation assembled and every node visible.",
  "type": "object",
  "$ref": "envelope.schema.json",
  "required": [
    "package"
  ],
  "properties": {
    "kind": {
      "const": "template"
    },
    "minAppVersion": {
      "description": "The oldest Locum version that installs this template, as x.y.z. Declare it when the template uses a node, a field or a trigger that older versions do not know; an older app lists the template marked and refuses to install it.",
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "manifest": false,
    "package": {
      "$ref": "#/$defs/locumPackage"
    }
  },
  "$defs": {
    "locumPackage": {
      "description": "The top of the locum-pacote format, versions 1 to 4. The app checks the inside of steps, triggers and agents again on import.",
      "type": "object",
      "required": [
        "formato",
        "versao",
        "automacao",
        "agents",
        "requisitos"
      ],
      "additionalProperties": false,
      "properties": {
        "formato": {
          "const": "locum-pacote"
        },
        "versao": {
          "enum": [
            1,
            2,
            3,
            4
          ]
        },
        "automacao": {
          "type": "object",
          "required": [
            "id",
            "spec",
            "gatilhos"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "$ref": "#/$defs/packageId"
            },
            "spec": {
              "$ref": "#/$defs/spec"
            },
            "gatilhos": {
              "type": "array",
              "maxItems": 20,
              "items": {
                "$ref": "#/$defs/trigger"
              }
            }
          }
        },
        "agents": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/agent"
          }
        },
        "requisitos": {
          "type": "object",
          "required": [
            "conexoes",
            "servidores",
            "provedores"
          ],
          "additionalProperties": false,
          "properties": {
            "conexoes": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "nome"
                ],
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "nome": {
                    "type": "string",
                    "minLength": 1
                  },
                  "instancias": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            },
            "servidores": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "nome"
                ],
                "additionalProperties": false,
                "properties": {
                  "nome": {
                    "type": "string",
                    "minLength": 1
                  },
                  "pacote": {
                    "type": "string",
                    "minLength": 1
                  },
                  "host": {
                    "type": "string",
                    "minLength": 1
                  },
                  "conexao": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            "provedores": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "provedor",
                  "modelos"
                ],
                "additionalProperties": false,
                "properties": {
                  "provedor": {
                    "type": "string",
                    "minLength": 1
                  },
                  "modelos": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            },
            "skills": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "nome"
                ],
                "additionalProperties": false,
                "properties": {
                  "nome": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        },
        "skills": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "required": [
              "nome",
              "descricao",
              "corpo"
            ],
            "additionalProperties": false,
            "properties": {
              "nome": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
              },
              "descricao": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000,
                "pattern": "\\S"
              },
              "corpo": {
                "type": "string",
                "maxLength": 65536
              }
            }
          }
        },
        "omitidos": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "codigo",
              "onde"
            ],
            "additionalProperties": false,
            "properties": {
              "codigo": {
                "enum": [
                  "canais",
                  "gatilho-sem-canal",
                  "filtros-de-pessoa",
                  "dono-do-github",
                  "tracker",
                  "argumentos",
                  "texto-limpo",
                  "url-a-preencher",
                  "escrita-removida",
                  "chats-a-escolher",
                  "destino-a-escolher",
                  "skill-ausente",
                  "passo-a-revisar",
                  "skill-nao-levada",
                  "instancia-mantida",
                  "id-do-slack"
                ]
              },
              "onde": {
                "type": "string",
                "minLength": 1
              },
              "quantos": {
                "type": "integer",
                "minimum": 1
              },
              "params": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "motivo": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "notas": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "type": "object",
            "required": [
              "scope",
              "text"
            ],
            "additionalProperties": false,
            "properties": {
              "scope": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "originUrl": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "packageId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
    },
    "spec": {
      "type": "object",
      "required": [
        "name",
        "steps"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "\\S"
        },
        "defaultTools": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "skills": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/step"
          }
        },
        "budget": {
          "type": "object"
        },
        "layout": {
          "type": "object"
        }
      }
    },
    "step": {
      "description": "A step as the package carries it: model, action (without target, which belongs to the machine) or logic. The app checks the inside of each field again on import.",
      "type": "object",
      "required": [
        "type",
        "key"
      ],
      "properties": {
        "type": {
          "enum": [
            "model",
            "action",
            "logic"
          ]
        },
        "key": {
          "type": "string",
          "minLength": 1
        },
        "needs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "model"
              }
            }
          },
          "then": {
            "additionalProperties": false,
            "required": [
              "key",
              "name",
              "type",
              "model",
              "prompt"
            ],
            "properties": {
              "key": true,
              "name": true,
              "needs": true,
              "optional": true,
              "when": true,
              "type": true,
              "model": true,
              "prompt": true,
              "tools": true,
              "requiresServers": true,
              "outputSchema": true,
              "maxSteps": true,
              "profile": true,
              "onTransientFailure": true,
              "memory": true
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "action"
              }
            }
          },
          "then": {
            "additionalProperties": false,
            "required": [
              "key",
              "name",
              "type",
              "action"
            ],
            "properties": {
              "key": true,
              "name": true,
              "needs": true,
              "optional": true,
              "when": true,
              "type": true,
              "action": true,
              "mode": true,
              "input": true,
              "pendingPerTarget": true,
              "params": true
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "logic"
              }
            }
          },
          "then": {
            "additionalProperties": false,
            "required": [
              "key",
              "name",
              "type",
              "op"
            ],
            "properties": {
              "key": true,
              "name": true,
              "needs": true,
              "optional": true,
              "when": true,
              "type": true,
              "op": true,
              "value": true,
              "compare": true,
              "against": true,
              "cases": true,
              "title": true
            }
          }
        }
      ]
    },
    "trigger": {
      "description": "A trigger without what belongs to the person (channels, chats, owner, authors): they choose it on import. Each kind says what it reads (x-reads-connection; x-reads-server, the field that names the server), whether it brings no event (x-no-event), and the fields the person picks when installing (x-person-chooses), with the values that would take everything and so count as not chosen (x-catch-all). A template leaves each of those out in one way: the app needs the field to create the trigger (x-required-to-run; in x-pending-choice too when the app, from 0.1.177, creates the trigger held with its whole config until the person chooses), an entry in omitidos with the code in x-omitted-code at gatilho:<position>, or the field in x-held-by that holds the trigger until the person chooses. A kind with filter also takes batch ($defs.batch).",
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "schedule",
            "webhook",
            "cron",
            "manual",
            "slack-inbox",
            "slack-channel",
            "github-thread-reply",
            "teams-inbox",
            "poll",
            "mcp-poll"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "schedule"
              }
            }
          },
          "then": {
            "additionalProperties": false,
            "required": [
              "kind",
              "everyMinutes"
            ],
            "properties": {
              "kind": true,
              "everyMinutes": true,
              "workingHours": true
            },
            "x-person-chooses": [],
            "x-no-event": true
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "webhook"
              }
            }
          },
          "then": {
            "additionalProperties": false,
            "required": [
              "kind"
            ],
            "properties": {
              "kind": true,
              "path": true
            },
            "x-person-chooses": [
              "path"
            ],
            "x-no-event": true,
            "x-omitted-code": {
              "path": "argumentos"
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "cron"
              }
            }
          },
          "then": {
            "additionalProperties": false,
            "required": [
              "kind",
              "expression"
            ],
            "properties": {
              "kind": true,
              "expression": true
            },
            "x-person-chooses": [],
            "x-no-event": true
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "manual"
              }
            }
          },
          "then": {
            "additionalProperties": false,
            "required": [
              "kind"
            ],
            "properties": {
              "kind": true
            },
            "x-person-chooses": []
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "slack-inbox"
              }
            }
          },
          "then": {
            "additionalProperties": false,
            "required": [
              "kind"
            ],
            "properties": {
              "kind": true,
              "mentions": true,
              "dms": true,
              "searchTool": true,
              "queryArg": true,
              "mentionsQuery": true,
              "dmsQuery": true,
              "itemsPath": true,
              "lookbackMinutes": true,
              "authorPath": true,
              "pageSize": true,
              "filter": {
                "$ref": "#/$defs/filter"
              },
              "batch": {
                "$ref": "#/$defs/batch"
              },
              "everyMinutes": true,
              "workingHours": true
            },
            "x-reads-connection": "slack",
            "x-person-chooses": [
              "myUserId"
            ],
            "x-omitted-code": {
              "myUserId": "id-do-slack"
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "slack-channel"
              }
            }
          },
          "then": {
            "additionalProperties": false,
            "required": [
              "kind"
            ],
            "properties": {
              "kind": true,
              "filter": {
                "$ref": "#/$defs/filter"
              },
              "batch": {
                "$ref": "#/$defs/batch"
              },
              "everyMinutes": true,
              "workingHours": true
            },
            "x-reads-connection": "slack",
            "x-person-chooses": [
              "channels"
            ],
            "x-required-to-run": [
              "channels"
            ],
            "x-pending-choice": [
              "channels"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "github-thread-reply"
              }
            }
          },
          "then": {
            "additionalProperties": false,
            "required": [
              "kind"
            ],
            "properties": {
              "kind": true,
              "repoMatch": true,
              "includeResolved": true,
              "maxRepliesPerThread": true,
              "maxRepliesPerPr": true,
              "lookbackMinutes": true,
              "excerptLines": true,
              "filter": {
                "$ref": "#/$defs/filter"
              },
              "batch": {
                "$ref": "#/$defs/batch"
              },
              "everyMinutes": true,
              "workingHours": true
            },
            "x-reads-connection": "github",
            "x-person-chooses": [
              "owner",
              "repoMatch"
            ],
            "x-omitted-code": {
              "owner": "dono-do-github",
              "repoMatch": "argumentos"
            },
            "x-catch-all": {
              "repoMatch": [
                ".*",
                "^.*$",
                ".+",
                "^.+$",
                ""
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "teams-inbox"
              }
            }
          },
          "then": {
            "additionalProperties": false,
            "required": [
              "kind"
            ],
            "properties": {
              "kind": true,
              "mentions": true,
              "dms": true,
              "prLinks": true,
              "agruparPrs": true,
              "maxPrs": true,
              "filtroIa": true,
              "filter": {
                "$ref": "#/$defs/filter"
              },
              "batch": {
                "$ref": "#/$defs/batch"
              },
              "everyMinutes": true,
              "workingHours": true,
              "chatsRestritos": true
            },
            "x-reads-connection": "teams",
            "x-person-chooses": [
              "chats"
            ],
            "x-held-by": {
              "chats": "chatsRestritos"
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "poll"
              }
            }
          },
          "then": {
            "additionalProperties": false,
            "required": [
              "kind",
              "source"
            ],
            "properties": {
              "kind": true,
              "source": true,
              "repoMatch": true,
              "authorship": true,
              "includeDrafts": true,
              "filters": true,
              "on": true,
              "onLabels": true,
              "checksGreen": true,
              "checksGreenMaxRevisits": true,
              "filter": {
                "$ref": "#/$defs/filter"
              },
              "batch": {
                "$ref": "#/$defs/batch"
              },
              "everyMinutes": true,
              "workingHours": true
            },
            "x-reads-connection": "github",
            "x-person-chooses": [
              "owner",
              "repoMatch"
            ],
            "x-omitted-code": {
              "owner": "dono-do-github"
            },
            "x-required-to-run": [
              "repoMatch"
            ],
            "x-catch-all": {
              "repoMatch": [
                ".*",
                "^.*$",
                ".+",
                "^.+$",
                ""
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "mcp-poll"
              }
            }
          },
          "then": {
            "additionalProperties": false,
            "required": [
              "kind",
              "server",
              "tool"
            ],
            "properties": {
              "kind": true,
              "server": true,
              "tool": true,
              "args": true,
              "filter": {
                "$ref": "#/$defs/filter"
              },
              "batch": {
                "$ref": "#/$defs/batch"
              },
              "everyMinutes": true,
              "workingHours": true
            },
            "x-reads-server": "server",
            "x-person-chooses": []
          }
        }
      ]
    },
    "filter": {
      "description": "Filter of the trigger, as the app reads it (TriggerFilter): the event only becomes a run when it passes every condition, with the comparisons of the if step. Absent or empty, every event passes. against takes only event markers, and with matches and no marker it is a regular expression; the validator checks both.",
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path"
        ],
        "properties": {
          "path": {
            "description": "The path in the event, as in {{event.<path>}} without event.",
            "type": "string",
            "pattern": "^[\\w-]+(\\.[\\w-]+)*$"
          },
          "compare": {
            "enum": [
              "equals",
              "not_equals",
              "contains",
              "not_contains",
              "greater",
              "less",
              "exists",
              "empty",
              "matches"
            ]
          },
          "against": {
            "type": "string",
            "maxLength": 500
          }
        }
      }
    },
    "batch": {
      "description": "Batch of the trigger, as the app reads it (TriggerBatch): the events that pass the filter join for windowMinutes and become one run, with at most max of them. Absent, each event is one run. The run of a batch reads the batch event, with the fields in x-event-fields, and not the fields of a single event.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "windowMinutes",
        "max"
      ],
      "properties": {
        "windowMinutes": {
          "description": "How long the batch stays open after its first event, from 1 minute to a week.",
          "type": "integer",
          "minimum": 1,
          "maximum": 10080
        },
        "max": {
          "description": "How many events the run takes; the ones past it are cut and counted in cut.",
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        }
      },
      "x-event-fields": [
        "items",
        "cut",
        "deferred",
        "count",
        "windowStart",
        "windowEnd"
      ]
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "model"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/packageId"
        },
        "name": {
          "type": "string",
          "pattern": "\\S"
        },
        "description": true,
        "context": true,
        "instructions": true,
        "model": {
          "type": "string",
          "minLength": 1
        },
        "temperature": true,
        "tools": true,
        "connections": true,
        "skills": true,
        "budget": true,
        "maxSteps": true
      }
    }
  }
}
