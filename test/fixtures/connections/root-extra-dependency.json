{
  "kind": "connection",
  "id": "root-extra-dependency",
  "version": 1,
  "description": {
    "en": "Example connection type.",
    "pt-BR": "Tipo de conexão de exemplo."
  },
  "name": {
    "en": "Example npm",
    "pt-BR": "Exemplo npm"
  },
  "manifest": {
    "category": "work",
    "logo": null,
    "color": "336699",
    "methods": [
      {
        "type": "token",
        "env": "EXAMPLE_TOKEN"
      }
    ],
    "servers": {
      "local": {
        "package": {
          "registry": "npm",
          "name": "example-mcp",
          "version": "1.2.3",
          "bin": "example-mcp",
          "lockfile": {
            "name": "example-npm",
            "lockfileVersion": 3,
            "requires": true,
            "packages": {
              "": {
                "dependencies": {
                  "example-mcp": "1.2.3",
                  "left-pad": "1.3.0"
                }
              },
              "node_modules/example-mcp": {
                "version": "1.2.3",
                "resolved": "https://registry.npmjs.org/example-mcp/-/example-mcp-1.2.3.tgz",
                "integrity": "sha512-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA==",
                "dependencies": {
                  "tiny-dep": "^2.0.0"
                },
                "bin": {
                  "example-mcp": "dist/cli.js"
                }
              },
              "node_modules/tiny-dep": {
                "version": "2.0.1",
                "resolved": "https://registry.npmjs.org/tiny-dep/-/tiny-dep-2.0.1.tgz",
                "integrity": "sha512-BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB=="
              }
            }
          }
        },
        "env": {
          "EXAMPLE_TOKEN": "${credential}"
        }
      }
    }
  }
}
