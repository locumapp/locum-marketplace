{
  "kind": "template",
  "id": "unknown-fields",
  "version": 1,
  "name": {
    "en": "Slack reply",
    "pt-BR": "Resposta no Slack"
  },
  "description": {
    "en": "Writes the reply to a Slack message and stops in the queue before posting.",
    "pt-BR": "Escreve a resposta a uma mensagem do Slack e para na fila antes de postar."
  },
  "tags": [
    "slack"
  ],
  "package": {
    "formato": "locum-pacote",
    "versao": 2,
    "automacao": {
      "id": "unknown-fields",
      "spec": {
        "name": "Resposta no Slack",
        "defaultTools": [],
        "skills": [],
        "budget": {
          "perRunUsd": 0.1,
          "perDayUsd": 1
        },
        "steps": [
          {
            "type": "model",
            "key": "write",
            "name": "Escrever a resposta",
            "needs": [],
            "optional": false,
            "model": "claude-code/claude-sonnet-5",
            "maxSteps": 4,
            "requiresServers": [],
            "prompt": "Escreva a resposta para esta mensagem de Slack, na thread dela.\n\nEm `text`, a resposta como ela sairia no canal: direta, sem saudação\nde e-mail e sem repetir a pergunta. Se faltar informação para\nresponder, escreva o que falta em vez de supor.\n\nCanal: {{event.channel}}\nThread: {{event.threadTs}}\nDe: {{event.author}}\n\nMensagem:\n{{event.text}}",
            "outputSchema": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "text"
              ],
              "properties": {
                "text": {
                  "type": "string"
                }
              }
            },
            "retries": 3
          },
          {
            "type": "action",
            "key": "post",
            "name": "Responder na thread",
            "needs": [
              "write"
            ],
            "optional": false,
            "action": "slack.post",
            "mode": "approve",
            "input": "write"
          }
        ]
      },
      "gatilhos": [
        {
          "kind": "manual",
          "channels": [
            "general"
          ]
        }
      ]
    },
    "agents": [
      {
        "id": "helper",
        "name": "Helper",
        "model": "claude-code/claude-sonnet-5",
        "toolsets": []
      }
    ],
    "requisitos": {
      "conexoes": [
        {
          "id": "slack",
          "nome": "Slack"
        }
      ],
      "servidores": [],
      "provedores": [
        {
          "provedor": "claude-code",
          "modelos": [
            "claude-sonnet-5"
          ]
        }
      ],
      "skills": []
    },
    "skills": [],
    "omitidos": []
  }
}
